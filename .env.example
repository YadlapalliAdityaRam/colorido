# Backend API server
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/colorido
ADMIN_EMAIL=admin@rvrjc.ac.in
ADMIN_PASSWORD=replace-with-a-unique-long-password
CORS_ORIGINS=http://localhost:5173

# Email Confirmation Service (Nodemailer / Brevo SMTP & API)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-brevo-smtp-key-or-app-password
EMAIL_FROM="COLORIDO 2K26" <your-email@example.com>
BREVO_API_KEY=your-brevo-api-key

# Frontend API URL: /api for same-origin deployment, or an absolute API URL.
VITE_API_BASE_URL=/api
# Vite development proxy target only.
VITE_API_PROXY_TARGET=http://localhost:5000
